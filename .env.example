# Web3Forms access key for the contact form (src/components/Contact.tsx).
#
# Production:  the REAL key lives ONLY in the EMAIL_API_KEY repo secret
#              (GitHub → Settings → Secrets and variables → Actions); the build
#              step in .github/workflows/deploy.yml maps it onto this
#              VITE_-prefixed var (Vite only exposes VITE_* vars to client code).
# Local dev:   copy this file to .env.local (gitignored). Any placeholder value
#              lets the app build and run; actual form submissions only succeed
#              with the real key.
# Tests:       never need it — vitest.config.ts injects a random per-run stub.
#
# Note: this is a client-side key by design (Web3Forms keys are public-facing);
# whatever value is present at build time is embedded in the built JS bundle.
VITE_WEB3FORMS_ACCESS_KEY=local-dev-placeholder
